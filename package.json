{
  "name": "flaretrace-browser-tests",
  "private": true,
  "type": "module",
  "description": "Test-only tooling for Flaretrace's unbundled browser JavaScript.",
  "scripts": {
    "test": "c8 --all --include='src/flaretrace/static/*.js' --reporter=text --reporter=lcov --reporter=json-summary --reporter=html --reports-dir=artifacts/ci/javascript/coverage --check-coverage --lines=90 --statements=90 --functions=90 --branches=90 node --test --test-isolation=none --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=artifacts/ci/javascript/junit.xml tests/javascript/*.test.mjs"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "15.4.0",
    "acorn": "8.19.0",
    "c8": "12.0.0",
    "happy-dom": "21.0.4"
  }
}
