# Start without setting credentials:
# ./scripts/flaretrace.sh start
# Username: admin. Read the generated password:
# ./scripts/flaretrace.sh password

# Optional administrator credentials. Username defaults to admin; an omitted
# password is generated once and persists in ./data across restarts and updates.
# ADMIN_USERNAME=alice
# ADMIN_PASSWORD=replace-with-a-long-random-password
# Records are retained indefinitely; legacy RETENTION_DAYS values are ignored.
PORT=8000
BIND_ADDRESS=127.0.0.1

# Domain, TLS, and published proxy ports are available as script options:
# ./scripts/flaretrace.sh start --domain trace.example.com --auto-tls
# ./scripts/flaretrace.sh start --domain trace.example.com --auto-tls --http-port 8080 --https-port 8443
# A domain automatically enables the proxy. Without --auto-tls it serves HTTP.
# Repeat the same options on recreate, upgrade, and start after stop.
# Certificate issuance still requires public inbound port 80 or 443, forwarded
# to the corresponding published port when you choose nonstandard host ports.

# Advanced/legacy overrides:
# PUBLIC_BASE_URL=https://trace.example.com
# SITE_ADDRESS=https://trace.example.com
# TRUST_PROXY=1
# COOKIE_SECURE=1
